---
import BaseLayout from "../components/layout/BaseLayout.astro";
import HeroMotion from "../components/hero/HeroMotion.jsx";
import ProjectLibrary from "../components/ProjectLibrary.astro";
import ProjectShowcase from "../components/ProjectShowcase.astro";
import { projectLibrary } from "../data/projects";

const meta = {
  title: "Hien Nguyen Ngoc | Full-Stack WebApp Developer",
  description:
    "I help SMEs, startups & businesses build scalable, secure, high-performance digital products — web apps, CRM/ERP systems, landing pages, desktop apps, AI integrations and programming mentoring.",
  url: "https://www.hiendevweb.com/",
};

const excludedSkills = new Set(["me"]);

const skillAssets = Object.entries(
  import.meta.glob("../assets/*.{png,jpg,jpeg,webp,svg}", { eager: true })
)
  .map(([path, mod]) => {
    const file = path.split("/").pop() || "";
    const label = file.replace(/\.(png|jpe?g|webp|svg)$/i, "").replace(/[-_]/g, " ");
    const src = mod.default?.src ?? mod.default ?? mod;
    return { src, label };
  })
  .filter((item) => !excludedSkills.has(item.label.toLowerCase()));

const normalize = (value) => value.toLowerCase().replace(/[^a-z0-9]/g, "");

const skillOrder = [
  {
    title: "Programming Languages",
    order: [
      ["js", "javascript"],
      ["typescript"],
      ["java"],
      ["python"],
      ["csharp", "c#"],
    ],
  },
  {
    title: "Technologies / Frameworks",
    order: [
      ["react"],
      ["tailwind", "tailwindcss"],
      ["spring", "springjava"],
      ["next", "nextjs"],
      ["nodejs", "node"],
      ["dotnet"],
    ],
  },
  {
    title: "Databases",
    order: [
      ["mysql"],
      ["postgres", "postgresql"],
      ["sqlserver", "sqlserver"],
      ["mongodb", "mongo"],
    ],
  },
  {
    title: "Other Tools",
    order: [
      ["pygame"],
      ["wordpress"],
      ["unity"],
      ["nginx"],
      ["github"],
      ["gitlab"],
    ],
  },
];

const displayNames = {
  js: "JavaScript",
  javascript: "JavaScript",
  typescript: "TypeScript",
  java: "Java",
  python: "Python",
  csharp: "C#",
  "c#": "C#",
  react: "React",
  tailwind: "Tailwind CSS",
  tailwindcss: "Tailwind CSS",
  spring: "Spring",
  springjava: "Spring",
  next: "Next.js",
  nextjs: "Next.js",
  nodejs: "Node.js",
  node: "Node.js",
  dotnet: ".NET",
  mysql: "MySQL",
  postgres: "PostgreSQL",
  postgresql: "PostgreSQL",
  sqlserver: "SQL Server",
  mongodb: "MongoDB",
  mongo: "MongoDB",
  pygame: "Pygame",
  wordpress: "WordPress",
  unity: "Unity",
  nginx: "Nginx",
  github: "GitHub",
  gitlab: "GitLab",
};

const findByKeys = (keys) =>
  skillAssets.find((skill) => keys.some((key) => normalize(skill.label).includes(normalize(key))));

const sparkleSet = new Set(["js", "javascript", "python", "java", "react", "mysql", "github"]);

const groupedSkills = skillOrder.map((group) => {
  const items = group.order
    .map((keys) => findByKeys(keys))
    .filter(Boolean);
  return { title: group.title, items };
});

const deckProjects = projectLibrary.filter((project) => project.deliveryType !== "similar");
const doneProjects = projectLibrary.filter((project) => project.deliveryType === "done");
const academicProjects = projectLibrary.filter((project) => project.deliveryType === "academic");
const templateProjects = projectLibrary.filter((project) => project.deliveryType === "similar");
const featuredProjects = projectLibrary.filter((project) => project.featured);

const findProject = (prefix: string) => {
  const project = projectLibrary.find((item) => item.projectName.startsWith(prefix));
  if (!project) throw new Error(`Unknown project: ${prefix}`);
  return project;
};

const services = [
  {
    tier: "Custom Web Apps & SaaS",
    title: "From MVP to production-ready platform",
    text: "React / Next.js frontends with Spring Boot, .NET or Node.js backends — auth, payments, wallets, dashboards and admin panels, deployed on your VPS or cloud.",
    points: ["MVP & SaaS builds", "Role-based access & payments", "REST API & database design", "Deploy, backups & monitoring"],
    proof: ["Gioi Truyen – Web Novel", "Mini LMS", "Atlantis"],
    cta: "Plan my web app",
    featured: true,
  },
  {
    tier: "ERP, CRM & Business Systems",
    title: "Internal tools that replace spreadsheets",
    text: "Customer, order, scheduling, inventory, invoicing and payroll systems shaped around how your team actually works — with Excel import so nothing is retyped.",
    points: ["CRM, ERP & booking systems", "Dispatch, invoices & reports", "Excel / CSV import & export", "Long-term maintenance"],
    proof: ["AquaCare CRM", "DentalPro"],
    cta: "Automate my workflow",
  },
  {
    tier: "Landing Pages & Business Websites",
    title: "Fast, conversion-focused sites",
    text: "WordPress, Elementor, Webflow or hand-coded sites built from your Figma or my design, with motion, on-page SEO and Core Web Vitals in mind.",
    points: ["Landing pages & company sites", "Figma → pixel-accurate code", "SEO & performance", "Bilingual VN / EN"],
    proof: ["Brilliance Imaging", "Joe Hoang", "Indochine Thai Nguyen Hotel"],
    cta: "See pricing",
    href: "#pricing",
  },
  {
    tier: "E-commerce & Booking",
    title: "Sell, rent or book online",
    text: "WooCommerce shops and custom carts, rental and booking flows, coin wallets and paid content — plus the admin side to manage orders.",
    points: ["Online shops & catalogs", "Rental / booking flows", "Paid content & virtual currency", "Order management"],
    proof: ["BotanicLane", "StageSound", "WordPress Paid-Chapter"],
    cta: "Start my store",
  },
  {
    tier: "Desktop Apps, AI & Data",
    title: "Beyond the browser",
    text: "C# WinForms / .NET desktop apps on SQL Server, data dashboards and AI features such as speech-to-text, LLM grading and text-to-speech.",
    points: ["C# WinForms & .NET desktop apps", "SQL Server, stored procedures", "AI integrations (Whisper, Gemini, TTS)", "Data dashboards & ML"],
    proof: ["Internship Management", "Mini LMS", "Rabies Surveillance"],
    cta: "Discuss my idea",
  },
  {
    tier: "Mentoring & Student Projects",
    title: "Learn by building real software",
    text: "1-on-1 or group coaching in JavaScript, Java, Python, C#, React and SQL, plus guidance for coursework, capstones and reports — with clean architecture and tests.",
    points: ["Programming tutoring", "Coursework & capstone guidance", "Code review & debugging", "Flexible online schedule"],
    proof: ["Internship Management", "LibraryMS", "Netflix User Segmentation"],
    cta: "Book a session",
  },
].map((service) => ({ ...service, proof: service.proof.map(findProject) }));
---
<BaseLayout title={meta.title} description={meta.description} url={meta.url}>
  <header class="pointer-events-none absolute inset-x-0 top-0 z-20 mx-auto flex w-[min(1120px,92vw)] justify-center pt-6">
    <nav class="nav-glow pointer-events-auto flex flex-wrap items-center gap-6 rounded-full border border-white/20 bg-white/90 px-8 py-3 text-sm font-semibold text-ink-2 shadow-[0_16px_40px_rgba(20,16,40,0.12)] dark:border-white/10 dark:bg-white/5 dark:text-white">
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#portfolio">Library</a>
      <a href="#pricing">Pricing</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <HeroMotion client:load />

  <section id="about" class="py-16 overflow-visible">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] items-start">
        <div>
          <h2 class="section-title font-display text-[clamp(1.9rem,3.2vw,2.7rem)] text-ink-2 dark:text-white">
            Business-oriented development for reliable digital products.
          </h2>
          <p class="mt-4 text-muted dark:text-slate-200">
            I'm Hien Nguyen Ngoc (HienDevWeb), a full-stack WebApp developer helping SMEs, startups and businesses
            build scalable, secure, high-performance digital products — from landing pages to enterprise systems
            (ERP, CRM, Logistics, Finance, Tracking, Booking, E-commerce, SaaS), solo or with a development team.
          </p>
          <div class="mt-6 grid gap-4 text-sm text-muted dark:text-slate-200">
            <div class="flex gap-4">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/70 text-sm font-semibold text-ink-2 shadow-[0_10px_24px_rgba(20,14,38,0.12)] dark:border-white/10 dark:bg-white/5 dark:text-white">01</span>
              <div>
                <strong class="block text-base text-ink-2 dark:text-white">Business-oriented development</strong>
                Solutions scoped around real business goals, not just features.
              </div>
            </div>
            <div class="flex gap-4">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/70 text-sm font-semibold text-ink-2 shadow-[0_10px_24px_rgba(20,14,38,0.12)] dark:border-white/10 dark:bg-white/5 dark:text-white">02</span>
              <div>
                <strong class="block text-base text-ink-2 dark:text-white">Scalable &amp; secure architecture</strong>
                REST APIs and system design built to grow with your business.
              </div>
            </div>
            <div class="flex gap-4">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/70 text-sm font-semibold text-ink-2 shadow-[0_10px_24px_rgba(20,14,38,0.12)] dark:border-white/10 dark:bg-white/5 dark:text-white">03</span>
              <div>
                <strong class="block text-base text-ink-2 dark:text-white">End-to-end delivery</strong>
                Database, backend, and frontend, tuned for performance.
              </div>
            </div>
            <div class="flex gap-4">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-white/30 bg-white/70 text-sm font-semibold text-ink-2 shadow-[0_10px_24px_rgba(20,14,38,0.12)] dark:border-white/10 dark:bg-white/5 dark:text-white">04</span>
              <div>
                <strong class="block text-base text-ink-2 dark:text-white">Long-term support</strong>
                Flexible solo or team delivery, with ongoing maintenance.
              </div>
            </div>
          </div>
        </div>
        <div class="grid gap-6 text-sm text-muted dark:text-slate-200">
          <div class="flex flex-col gap-2">
            <span class="text-xs uppercase tracking-[0.2em] text-muted">Frontend</span>
            <p>React.js, Next.js, TypeScript, Tailwind CSS</p>
          </div>
          <div class="flex flex-col gap-2">
            <span class="text-xs uppercase tracking-[0.2em] text-muted">Backend</span>
            <p>.NET, Java Spring Boot, Node.js</p>
          </div>
          <div class="flex flex-col gap-2">
            <span class="text-xs uppercase tracking-[0.2em] text-muted">Database &amp; API</span>
            <p>PostgreSQL, MySQL, SQL Server, REST API &amp; system architecture</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="py-16">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#6f5fd4] dark:text-lavender-2">What I can build for you</p>
      <h2 class="section-title mt-3 font-display text-[clamp(1.9rem,3.2vw,2.7rem)] text-ink-2 dark:text-white">
        Services
      </h2>
      <p class="mt-4 max-w-2xl text-muted dark:text-slate-200">
        Six ways I help businesses and students ship software. Every service below is backed by real projects —
        tap a project name to see its screenshots.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3 items-stretch">
        {services.map((service, index) => {
          const body = (
            <>
              <div class="pricing-tier text-[#6f5fd4]">{service.tier}</div>
              <h3 class="mt-4 text-lg font-semibold text-ink-2 dark:text-white">{service.title}</h3>
              <p class="mt-4 text-sm text-muted dark:text-slate-200">{service.text}</p>
              <ul class="mt-5 grid gap-2 text-sm text-muted dark:text-slate-200">
                {service.points.map((point) => <li>{point}</li>)}
              </ul>
              <div class="service-proof">
                <span>Proof</span>
                {service.proof.map((project) => (
                  <button type="button" data-open-project={project.projectName}>
                    {project.projectName.split(" – ")[0]}
                  </button>
                ))}
              </div>
              <div class="mt-auto pt-6">
                <a class="pricing-cta" href={service.href ?? "#contact"}>{service.cta}</a>
              </div>
            </>
          );
          return service.featured ? (
            <article class="pricing-card featured reveal" style={`--delay: ${80 + index * 60}ms;`}>
              <div class="pricing-badge">Most requested</div>
              <div class="pricing-card__inner">{body}</div>
            </article>
          ) : (
            <article class="pricing-card reveal" style={`--delay: ${80 + index * 60}ms;`}>{body}</article>
          );
        })}
      </div>
      <div class="service-strip reveal" style="--delay: 200ms;">
        <p>
          <strong>Also available:</strong> bug fixing on live sites, WordPress / PHP customization, VPS deployment,
          backups and ongoing maintenance.
        </p>
        <a class="pricing-cta" href="#contact">Get a free scope call</a>
      </div>
    </div>
  </section>

  <section id="work" class="py-16">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#6f5fd4] dark:text-lavender-2">Case studies</p>
      <h2 class="section-title mt-3 font-display text-[clamp(1.9rem,3.2vw,2.7rem)] text-ink-2 dark:text-white">
        Featured Work
      </h2>
      <div class="mt-10 grid gap-16">
        {featuredProjects.map((project, index) => (
          <article class={`case reveal ${index % 2 ? "is-flipped" : ""}`} style="--delay: 80ms;">
            <button type="button" class="case__shot" data-open-project={project.projectName} aria-label={`View screenshots of ${project.projectName}`}>
              <span class="case__bar" aria-hidden="true"><i></i><i></i><i></i></span>
              <img src={project.imageUrl} alt={`${project.projectName} screenshot`} loading="lazy" decoding="async" />
              {project.gallery && project.gallery.length > 1 ? (
                <span class="case__count">{project.gallery.length} screenshots</span>
              ) : null}
            </button>
            <div class="case__body">
              <div class="case__meta">
                {project.service ? <span class="case__service">{project.service}</span> : null}
                {project.status ? <span class="case__status">{project.status}</span> : null}
              </div>
              <h3 class="mt-3 font-display text-2xl text-ink-2 dark:text-white">{project.projectName}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted dark:text-slate-200">{project.description}</p>
              {project.highlights ? (
                <ul class="case__highlights">
                  {project.highlights.map((item) => <li>{item}</li>)}
                </ul>
              ) : null}
              <div class="case__tech">
                {project.technologies.map((tech) => <span>{tech}</span>)}
              </div>
              <div class="mt-6 flex flex-wrap items-center gap-4">
                <button type="button" class="pricing-cta !mt-0" data-open-project={project.projectName}>View screenshots</button>
                {project.websiteURL ? (
                  <a class="case__link" href={project.websiteURL} target="_blank" rel="noreferrer">Visit live site →</a>
                ) : null}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="py-16">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <h2 class="section-title font-display text-[clamp(1.9rem,3.2vw,2.7rem)] text-ink-2 dark:text-white">
        All Projects
      </h2>
      <p class="mt-4 max-w-2xl text-muted dark:text-slate-200">
        Client work, products and academic builds — pick a card to see screenshots, highlights and the stack.
      </p>
      <div id="project-tabs" class="mt-6 flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-ink-2 dark:text-white">
        <button class="project-tab is-active" type="button" data-filter="All">All</button>
        <button class="project-tab" type="button" data-filter="Web App">Web App</button>
        <button class="project-tab" type="button" data-filter="Business">Business</button>
        <button class="project-tab" type="button" data-filter="E-commerce">E-commerce</button>
        <button class="project-tab" type="button" data-filter="Creative">Creative</button>
        <button class="project-tab" type="button" data-filter="Academic">Academic</button>
      </div>
      <div id="project-gallery" class="mt-8">
        <ProjectShowcase projects={deckProjects} />
      </div>
    </div>
  </section>

  <section id="skills" class="py-14">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <h2 class="section-title font-display text-[clamp(1.8rem,3vw,2.6rem)] text-ink-2 dark:text-white">
        Skills &amp; Stack
      </h2>
      <div class="mt-8 grid gap-8 reveal" style="--delay: 120ms;">
        {groupedSkills.map((group) =>
          group.items.length ? (
            <div class="grid gap-5">
              <div class="flex items-center gap-4">
                <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/30 to-transparent dark:via-white/10"></div>
                <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-muted dark:text-slate-300">
                  {group.title}
                </h3>
                <div class="h-px flex-1 bg-gradient-to-r from-transparent via-white/30 to-transparent dark:via-white/10"></div>
              </div>
              <div class="flex flex-wrap justify-center gap-8">
                {group.items.map((skill, skillIndex) => (
                  <div
                    class={`group relative h-24 w-24 cursor-pointer rounded-full p-[1px] shadow-[0_18px_36px_rgba(40,25,80,0.28)] transition hover:-translate-y-1 hover:shadow-[0_26px_50px_rgba(40,25,80,0.42)] skill-ring bell-wobble ${
                      sparkleSet.has(normalize(skill.label)) ? "sparkle-ring" : ""
                    }`}
                    style={`animation-delay: ${(skillIndex % 6) * 0.35}s;`}
                  >
                    <div class="relative h-full w-full rounded-full bg-transparent p-[1px] skill-core">
                    <img
                      src={skill.src}
                      alt={displayNames[normalize(skill.label)] ?? skill.label}
                      title={displayNames[normalize(skill.label)] ?? skill.label}
                      class="h-full w-full rounded-full object-contain transition duration-300 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ) : null
        )}
    </div>
  </section>

  <section id="portfolio" class="py-16">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <h2 class="section-title font-display text-[clamp(1.8rem,3vw,2.6rem)] text-ink-2 dark:text-white">
        Project Library
      </h2>
      <div class="mt-8">
        <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-muted dark:text-slate-300">
          Completed Projects
        </h3>
        <div class="mt-6">
          <ProjectLibrary projects={doneProjects} />
        </div>
      </div>
      <div class="mt-12">
        <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-muted dark:text-slate-300">
          Academic &amp; Learning Projects
        </h3>
        <div class="mt-6">
          <ProjectLibrary projects={academicProjects} showLinks={false} />
        </div>
      </div>
      <div class="mt-12">
        <h3 class="text-xs font-semibold uppercase tracking-[0.3em] text-muted dark:text-slate-300">
          Template Projects
        </h3>
        <div class="mt-6">
          <ProjectLibrary projects={templateProjects} />
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="py-16">
    <div class="mx-auto w-[min(1120px,92vw)]">
      <h2 class="section-title font-display text-[clamp(1.8rem,3vw,2.6rem)] text-ink-2 dark:text-white">
        Landing Page &amp; WebApp Pricing
      </h2>
      <p class="mt-4 max-w-2xl text-sm text-muted dark:text-slate-200">
        Fixed-scope pricing for landing pages and WebApps. Enterprise systems and mentoring are quoted per project —
        <a href="#contact" class="underline decoration-[#7e68d4]/50 underline-offset-4 hover:text-ink-2 dark:hover:text-white">get in touch</a> for a scope call.
      </p>
      <div class="mt-7 grid gap-6 md:grid-cols-3 items-stretch">
        <article class="pricing-card reveal" style="--delay: 80ms;">
          <div class="pricing-tier text-[#6f5fd4]">Basic</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-2 dark:text-white">
            Fast start for MVP &amp; small launches
          </h3>
          <ul class="mt-5 grid gap-2 text-sm text-muted dark:text-slate-200">
            <li>1 landing page</li>
            <li>Clean UI design</li>
            <li>Basic motion (hover / scroll)</li>
            <li>Mobile responsive</li>
            <li>Basic SEO</li>
            <li>Deploy &amp; handoff</li>
          </ul>
          <div class="mt-auto pt-6">
            <div class="text-2xl font-bold text-ink-2 dark:text-white">$45 - $125</div>
            <div class="text-sm text-muted dark:text-slate-200">Delivery: 1-7 days</div>
            <a class="pricing-cta" href="#contact">Start a project</a>
          </div>
        </article>

        <article class="pricing-card featured reveal" style="--delay: 160ms;">
          <div class="pricing-badge">Most Popular</div>
          <div class="pricing-card__inner">
            <div class="pricing-tier text-[#6f5fd4]">Pro</div>
            <h3 class="mt-4 text-lg font-semibold text-ink-2 dark:text-white">
              Conversion-focused landing for serious products
            </h3>
            <ul class="mt-5 grid gap-2 text-sm text-muted dark:text-slate-200">
              <li>Conversion-optimized layout</li>
              <li>Advanced motion &amp; light 3D</li>
              <li>Full on-page SEO structure</li>
              <li>Core Web Vitals optimization</li>
              <li>Contact form &amp; analytics tracking</li>
              <li>1 major + 2 minor revisions</li>
            </ul>
            <div class="mt-auto pt-6">
              <div class="text-2xl font-bold text-ink-2 dark:text-white">$120 - $360</div>
              <div class="text-sm text-muted dark:text-slate-200">Delivery: 7-21 days</div>
              <a class="pricing-cta" href="#contact">Start a project</a>
            </div>
          </div>
        </article>

        <article class="pricing-card reveal" style="--delay: 240ms;">
          <div class="pricing-tier text-[#6f5fd4]">Premium</div>
          <h3 class="mt-4 text-lg font-semibold text-ink-2 dark:text-white">
            Custom 3D motion &amp; scalable landing system
          </h3>
          <ul class="mt-5 grid gap-2 text-sm text-muted dark:text-slate-200">
            <li>Custom 3D animation</li>
            <li>Funnel &amp; copy structure</li>
            <li>A/B testing concept</li>
            <li>Advanced performance &amp; SEO</li>
            <li>30-day post-launch support</li>
          </ul>
          <div class="mt-auto pt-6">
            <div class="text-2xl font-bold text-ink-2 dark:text-white">$360 - $999</div>
            <div class="text-sm text-muted dark:text-slate-200">Delivery: 14-60 days</div>
