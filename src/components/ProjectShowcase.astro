---
import type { Project } from "../data/projects";

type Props = {
  projects: Project[];
};

const { projects } = Astro.props;

const categoryAccent: Record<Project["category"], string> = {
  "Web App": "244 199 106",
  Academic: "251 146 196",
  Business: "148 120 255",
  "E-commerce": "110 231 168",
  Game: "255 158 122",
  Creative: "125 211 252",
};

const getHost = (url?: string) => {
  if (!url) return null;
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<div class="deck-wrap">
  <div class="deck" id="project-deck">
    {
      projects.map((project, index) => {
        const accent = categoryAccent[project.category];
        const host = getHost(project.websiteURL);
        const face = project.logoUrl ?? project.imageUrl ?? "";
        const media = project.imageUrl ?? project.logoUrl ?? "";

        return (
          <button
            type="button"
            class="deck-card"
            data-category={project.category}
            data-name={project.projectName}
            data-desc={project.description}
            data-role={project.role}
            data-host={host ?? ""}
            data-url={project.websiteURL ?? ""}
            data-tech={project.technologies.join(",")}
            data-logo={face}
            data-image={media}
            data-status={project.status ?? ""}
            data-gallery={JSON.stringify(project.gallery ?? (media ? [media] : []))}
            data-highlights={JSON.stringify(project.highlights ?? [])}
            style={`--accent: ${accent}; --order: ${index};`}
            aria-label={`Open ${project.projectName}`}
          >
            <span class="deck-card__face">
              <span class="deck-card__name">{project.projectName}</span>
              <span class={`deck-card__plate ${project.logoUrl ? "" : "is-shot"}`}>
                {face ? <img src={face} alt={project.projectName} loading="lazy" decoding="async" /> : null}
              </span>
              <span class="deck-card__category">{project.category}</span>
            </span>
          </button>
        );
      })
    }
  </div>
</div>

<div class="lightbox" id="project-lightbox" aria-hidden="true">
  <div class="lightbox__backdrop" data-close></div>
  <div class="lightbox__stage">
    <div class="lightbox__frame" id="lightbox-frame">
      <article class="lightbox__card" id="lightbox-card">
        <button type="button" class="lightbox__close" data-close aria-label="Close">
          ✕
        </button>
        <div class="lightbox__media">
          <img id="lightbox-image" src="" alt="" />
          <span class="lightbox__logo"><img id="lightbox-logo" src="" alt="" /></span>
          <span class="lightbox__category" id="lightbox-category"></span>
          <span class="lightbox__status" id="lightbox-status"></span>
        </div>
        <div class="lightbox__thumbs" id="lightbox-thumbs"></div>
        <div class="lightbox__body">
          <div class="lightbox__top">
            <h3 id="lightbox-name"></h3>
            <span id="lightbox-host"></span>
          </div>
          <p id="lightbox-desc"></p>
          <ul class="lightbox__highlights" id="lightbox-highlights"></ul>
          <div class="lightbox__tech" id="lightbox-tech"></div>
          <div class="lightbox__footer">
            <span id="lightbox-role"></span>
            <a id="lightbox-visit" href="#" target="_blank" rel="noreferrer">
              Visit site →
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</div>

<script>
  const CARD_WIDTH = 224;
  const OVERLAP_DESKTOP = 78;
  const OVERLAP_MOBILE = 56;
  const AMPLITUDE = 34;

  const track = document.getElementById("project-deck") as HTMLElement | null;
  const allCards = Array.from(document.querySelectorAll<HTMLButtonElement>(".deck-card"));

  const layoutDeck = () => {
    if (!track) return;
    const overlap = window.innerWidth < 640 ? OVERLAP_MOBILE : OVERLAP_DESKTOP;
    const visible = allCards.filter((card) => card.style.display !== "none");
    const n = visible.length;

    visible.forEach((card, i) => {
      const t = n > 1 ? i / (n - 1) : 0.5;
      const y = Math.sin(t * Math.PI * 1.15 - 0.25) * AMPLITUDE;
      const rot = (t - 0.5) * 18;
      card.style.left = `${i * overlap}px`;
      card.style.zIndex = String(i + 1);
      card.style.setProperty("--card-y", `${y}px`);
      card.style.setProperty("--card-rot", `${rot}deg`);
    });

    track.style.width = `${Math.max(0, n - 1) * overlap + CARD_WIDTH}px`;
  };

  layoutDeck();
  window.addEventListener("resize", layoutDeck);

  // Category tab filtering
  const tabsEl = document.getElementById("project-tabs");
  if (tabsEl) {
    tabsEl.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".project-tab");
      if (!button) return;

      tabsEl.querySelectorAll(".project-tab").forEach((tab) => tab.classList.remove("is-active"));
      button.classList.add("is-active");

      const filter = button.dataset.filter ?? "All";
      allCards.forEach((card) => {
        const matches = filter === "All" || card.dataset.category === filter;
        card.style.display = matches ? "" : "none";
      });
      layoutDeck();
    });
  }

  // Zoom-to-center lightbox (FLIP animation)
  const lightbox = document.getElementById("project-lightbox") as HTMLElement | null;
  const frameEl = document.getElementById("lightbox-frame") as HTMLElement | null;
  const lbImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
  const lbLogo = document.getElementById("lightbox-logo") as HTMLImageElement | null;
  const lbCategory = document.getElementById("lightbox-category");
  const lbName = document.getElementById("lightbox-name");
  const lbHost = document.getElementById("lightbox-host");
  const lbDesc = document.getElementById("lightbox-desc");
  const lbTech = document.getElementById("lightbox-tech");
  const lbRole = document.getElementById("lightbox-role");
  const lbVisit = document.getElementById("lightbox-visit") as HTMLAnchorElement | null;
  const lbStatus = document.getElementById("lightbox-status");
  const lbThumbs = document.getElementById("lightbox-thumbs");
  const lbHighlights = document.getElementById("lightbox-highlights");

  const parseList = (value?: string): string[] => {
    try {
      const list = JSON.parse(value ?? "[]");
      return Array.isArray(list) ? list : [];
    } catch {
      return [];
    }
  };

  let activeTrigger: HTMLElement | null = null;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const flipFrom = (rectFrom: DOMRect, rectTo: DOMRect) => {
    const dx = rectFrom.left + rectFrom.width / 2 - (rectTo.left + rectTo.width / 2);
    const dy = rectFrom.top + rectFrom.height / 2 - (rectTo.top + rectTo.height / 2);
    const sx = rectFrom.width / rectTo.width;
    const sy = rectFrom.height / rectTo.height;
    return `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
  };

  // Zoom origin: the element the user clicked (a deck card or a "view screenshots" button elsewhere)
  const openCard = (trigger: HTMLButtonElement, origin: HTMLElement = trigger) => {
    if (!lightbox || !frameEl || !lbImage || !lbLogo) return;
    activeTrigger = origin;

    lbImage.src = trigger.dataset.image ?? "";
    lbImage.alt = trigger.dataset.name ?? "";
    const logo = trigger.dataset.logo ?? "";
    lbLogo.src = logo;
    lbLogo.alt = "";
    lbLogo.parentElement?.toggleAttribute("hidden", !logo || logo === trigger.dataset.image);
    if (lbStatus) {
      lbStatus.textContent = trigger.dataset.status ?? "";
      lbStatus.toggleAttribute("hidden", !trigger.dataset.status);
    }

    if (lbThumbs) {
      lbThumbs.innerHTML = "";
      const gallery = parseList(trigger.dataset.gallery);
      lbThumbs.toggleAttribute("hidden", gallery.length < 2);
      gallery.forEach((src, i) => {
        const thumb = document.createElement("button");
        thumb.type = "button";
        thumb.className = `lightbox__thumb${i === 0 ? " is-active" : ""}`;
        thumb.setAttribute("aria-label", `Screenshot ${i + 1}`);
        const img = document.createElement("img");
        img.src = src;
        img.alt = "";
        img.loading = "lazy";
        thumb.appendChild(img);
        thumb.addEventListener("click", () => {
          lbImage.src = src;
          lbThumbs.querySelectorAll(".lightbox__thumb").forEach((el) => el.classList.remove("is-active"));
          thumb.classList.add("is-active");
        });
        lbThumbs.appendChild(thumb);
      });
    }

    if (lbHighlights) {
      lbHighlights.innerHTML = "";
      parseList(trigger.dataset.highlights).forEach((text) => {
        const li = document.createElement("li");
        li.textContent = text;
        lbHighlights.appendChild(li);
      });
    }
    if (lbCategory) lbCategory.textContent = trigger.dataset.category ?? "";
    if (lbName) lbName.textContent = trigger.dataset.name ?? "";
    if (lbHost) lbHost.textContent = trigger.dataset.host ?? "";
    if (lbDesc) lbDesc.textContent = trigger.dataset.desc ?? "";
    if (lbRole) lbRole.textContent = trigger.dataset.role ?? "";

    if (lbTech) {
      lbTech.innerHTML = "";
      (trigger.dataset.tech ?? "")
        .split(",")
        .filter(Boolean)
        .forEach((tech) => {
          const span = document.createElement("span");
          span.textContent = tech;
          lbTech.appendChild(span);
        });
    }

    const url = trigger.dataset.url ?? "";
    if (lbVisit) {
      if (url) {
        lbVisit.href = url;
        lbVisit.style.display = "";
      } else {
        lbVisit.style.display = "none";
      }
    }

    const accent = getComputedStyle(trigger).getPropertyValue("--accent");
    frameEl.style.setProperty("--accent", accent);

    document.body.style.overflow = "hidden";
    lightbox.classList.add("is-open");
    lightbox.setAttribute("aria-hidden", "false");

    if (reduced) return;

    const startRect = origin.getBoundingClientRect();
    if (!startRect.width || !startRect.height) return;
    requestAnimationFrame(() => {
      const endRect = frameEl.getBoundingClientRect();
      frameEl.style.transition = "none";
      frameEl.style.transform = flipFrom(startRect, endRect);
      frameEl.style.opacity = "0.9";
      requestAnimationFrame(() => {
        frameEl.style.transition = "transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease";
        frameEl.style.transform = "translate(0, 0) scale(1, 1)";
        frameEl.style.opacity = "1";
      });
    });
  };

  const closeCard = () => {
    if (!lightbox || !frameEl) return;

    const finish = () => {
      lightbox.classList.remove("is-open");
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      frameEl.style.transition = "none";
      frameEl.style.transform = "";
      frameEl.style.opacity = "";
      activeTrigger = null;
    };

    const originRect = activeTrigger?.getBoundingClientRect();
    if (reduced || !activeTrigger || !originRect?.width) {
      finish();
      return;
    }

    const currentRect = frameEl.getBoundingClientRect();
    frameEl.style.transition = "transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease";
    frameEl.style.transform = flipFrom(originRect, currentRect);
    frameEl.style.opacity = "0";

    const onEnd = () => {
      frameEl.removeEventListener("transitionend", onEnd);
      finish();
    };
    frameEl.addEventListener("transitionend", onEnd);
  };

  allCards.forEach((card) => {
    card.addEventListener("click", () => openCard(card));
  });

  document.addEventListener("click", (event) => {
    const opener = (event.target as HTMLElement).closest<HTMLElement>("[data-open-project]");
    if (!opener) return;
    const card = allCards.find((item) => item.dataset.name === opener.dataset.openProject);
    if (card) openCard(card, opener);
  });

  lightbox?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("[data-close]")) closeCard();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox?.classList.contains("is-open")) closeCard();
  });
</script>
